# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual env & package caches (kept local to workspace)
.venv/
.uv-cache/
.hf-cache/
.hf-home/

# Generated data & artifacts
data/*.jsonl
outputs/
runs/
checkpoints/
*.ckpt
*.pt
*.bin
*.safetensors
wandb/

# Secrets
.env
.env.*

# OS
.DS_Store

# matplotlib cache (redirected into workspace to avoid ~/.matplotlib)
.mpl-cache/

# NOTE: small text logs under logs/ are committed on purpose (spec requires
# logs). Rollout dumps / large logs go under outputs/ (ignored above), not logs/.

# bucket mirror written by scripts/pull_checkpoints.sh
mirror/

# Experiment logs under verification/logs/ are committed (they back the numbers in EXPERIMENTS.md and
# VERIFICATION.md), including eval dumps that were pulled into an outputs/ subfolder. Per-step in-run validation
# dumps and rollout dumps are left out: they are large, and complete copies live in the GCS bucket
# (runs/<run_id>/logs/val/, runs/<run_id>/...).
!verification/logs/**/outputs/
verification/logs/*/run/val/
verification/logs/**/rollouts.jsonl
